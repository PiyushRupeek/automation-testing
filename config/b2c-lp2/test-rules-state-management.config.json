    {
      "id": "takeover-drop-offer-resume",
      "name": "Takeover — drop at offer page, resume via re-auth",
      "loanType": "takeover",
      "description": "User completes shift page (Skip path) and reaches offer page. Drop and re-auth should restore to offer page with takeover webFlow intact.",
      "flow": [
        {
          "step": 1,
          "phase": "setup",
          "name": "Takeover setup — reach offer page via Skip",
          "url": "/lp/b2c/2",
          "actions": [
            {
              "type": "click",
