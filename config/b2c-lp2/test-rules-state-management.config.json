            },
            {
              "type": "click",
              "label": "Continue on pincode modal"
            },
            {
              "type": "click",
              "label": "Yes, That's Me"
            },
            {
              "type": "click",
              "label": "Get New loan option card"
            },
            {
              "type": "click",
              "label": "Continue on loan type page"
            },
            {
              "type": "click",
              "label": "Select button on Lowest Interest Rate preference card"
            },
            {
              "type": "click",
              "label": "Show My Offers button on gold weight page"
            }
          ],
          "assertions": [
            {
              "type": "element_visible",
              "label": "Total Loan Amount"
            },
            {
              "type": "url_contains",
              "value": "/lp/b2c/offer-page"
            }
          ]
        },
        {
          "step": 2,
          "phase": "reload",
          "name": "Hard reload current page",
          "actions": [
            {
              "type": "reload"
            }
          ],
          "assertions": [
            {
              "type": "element_visible",
              "label": "Total Loan Amount"
            },
            {
              "type": "url_contains",
              "value": "/lp/b2c/offer-page"
            },
            {
              "type": "no_error_toast"
            }
          ],
          "notes": "If redirected to landing, sessionStorage hydration or bookingId guard failed"
        }
      ]
    },
    {
      "id": "fresh-cold-resume-clear-session",
      "name": "Fresh — cold resume after clearing sessionStorage",
      "loanType": "fresh",
      "description": "Clear sessionStorage but keep cookies. Re-auth via OTP should still deep-link correctly using backend stateContext.deepLinkTarget.",
      "flow": [
        {
          "step": 1,
          "phase": "setup",
          "name": "Reach offer page",
          "url": "/lp/b2c/2",
          "actions": [
            {
              "type": "click",
              "label": "Get Started"
            },
            {
              "type": "fill",
              "label": "Mobile number input",
              "value": "{{credentials.mobileFresh}}"
            },
            {
              "type": "click",
              "label": "Continue on phone auth modal"
            },
            {
              "type": "fill",
              "label": "OTP input",
              "value": "{{prompt.otp}}"
            },
            {
              "type": "click",
              "label": "Continue on OTP modal"
            },
            {
              "type": "fill",
              "label": "Pincode input",
              "value": "{{loanDetails.pincode}}"
            },
            {
              "type": "click",
              "label": "Continue on pincode modal"
            },
            {
              "type": "click",
              "label": "Yes, That's Me"
            },
            {
              "type": "click",
              "label": "Get New loan option card"
            },
            {
              "type": "click",
              "label": "Continue on loan type page"
            },
            {
              "type": "click",
              "label": "Select button on Lowest Interest Rate preference card"
            },
            {
              "type": "click",
              "label": "Show My Offers button on gold weight page"
            }
          ],
          "assertions": [
            {
              "type": "element_visible",
              "label": "Total Loan Amount"
            }
          ]
        },
        {
          "step": 2,
          "phase": "drop",
          "name": "Clear sessionStorage and navigate to landing",
          "actions": [
            {
              "type": "clear_storage",
              "target": "sessionStorage"
            },
            {
              "type": "navigate",
              "value": "/lp/b2c/2"
            }
          ],
          "assertions": [
            {
              "type": "element_visible",
              "label": "Get Started"
            }
          ],
          "notes": "Clears jsonData.webFlow from session — resume must rebuild webFlow from booking loan type via OtpStep syncWebFlowFromLoanType"
        },
        {
          "step": 3,
          "phase": "resume",
          "name": "Resume — OTP deep link after cold session",
          "actions": [
            {
              "type": "click",
              "label": "Get Started"
            },
            {
              "type": "fill",
              "label": "Mobile number input",
              "value": "{{credentials.mobileFresh}}"
            },
            {
              "type": "click",
              "label": "Continue on phone auth modal"
            },
            {
              "type": "fill",
              "label": "OTP input",
              "value": "{{prompt.otp}}"
            },
            {
              "type": "click",
              "label": "Continue on OTP modal"
            }
          ],
          "assertions": [
            {
              "type": "element_visible",
              "label": "Total Loan Amount"
            },
            {
              "type": "url_contains",
              "value": "/lp/b2c/offer-page"
            },
            {
              "type": "no_error_toast"
            }
          ]
        }
      ]
    },
