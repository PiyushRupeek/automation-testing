# =============================================================================
# Copy to .env and fill in values — never commit .env to git
# cp .env.example .env
# =============================================================================

# --- Required: Claude API ---
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Required: Target site ---
BASE_URL=https://rupeek.com/lp/b2c/2

# --- Required: B2C test credentials ---
TEST_MOBILE=9999999999
TEST_MOBILE_FRESH=9999999999
TEST_MOBILE_TAKEOVER=8888888888
TEST_PAN=ABCDE1234F
TEST_PINCODE=560001
# Leave empty when INTERACTIVE_OTP=true (CLI prompts for OTP)
TEST_OTP=

# --- Test run options ---
TEST_VARIANT=fresh
TEST_MODE=

# --- OTP behaviour ---
INTERACTIVE_OTP=true
OTP_PROMPT_DELAY_MS=3000

# --- Playwright / browser ---
HEADLESS=true
# Path to Chrome/Chromium binary — leave empty to use Playwright's bundled browser
CHROME_EXECUTABLE_PATH=

# --- Self-healing (AI auto-recovery on failures) ---
AUTO_HEAL=true
AUTO_HEAL_MAX_ATTEMPTS=3

# --- Optional: Notifications ---
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
ALERT_EMAIL=team@rupeek.com

# --- API server (only needed for npm run start:api / dev:api) ---
PORT=3000
API_HOST=0.0.0.0
MAX_CONCURRENT_RUNS=1
OTP_API_TIMEOUT_MS=120000
