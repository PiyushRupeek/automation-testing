# =============================================================================
# Copy to .env and fill in — never commit .env to git
# cp .env.example .env
# =============================================================================

# --- Required: Claude API ---
ANTHROPIC_API_KEY=sk-ant-...

# --- Required: Target site ---
BASE_URL=https://rupeek.com/lp/b2c/2
STAGING_BASE_URL=

# --- Required: B2C test credentials ---
TEST_MOBILE=9999999999
TEST_OTP=
TEST_PAN=ABCDE1234F
TEST_PINCODE=560001

# --- Optional: New-user auth path ---
TEST_FIRST_NAME=
TEST_LAST_NAME=

# --- Test run options ---
TEST_VARIANT=fresh
TEST_MODE=

# --- Optional: Notifications ---
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
ALERT_EMAIL=team@rupeek.com

# --- Optional: Playwright / browser ---
PLAYWRIGHT_BROWSERS_PATH=
HEADLESS=true
SLOW_MO=0

INTERACTIVE_OTP=true
OTP_PROMPT_DELAY_MS=3000

# --- Self-healing (AI auto-recovery on failures) ---
AUTO_HEAL=true
AUTO_HEAL_MAX_ATTEMPTS=3

# --- Optional: Timeouts (ms) ---
NAVIGATION_TIMEOUT=
ACTION_TIMEOUT=

# --- Optional: CI ---
# CI=true
