{
  "name": "automated-testing",
  "version": "1.0.0",
  "description": "AI-powered UI test automation for gold loan booking flow",
  "scripts": {
    "build": "nest build",
    "start:api": "node dist/main.js",
    "dev:api": "nest start --watch",
    "test": "ts-node -r reflect-metadata src/cli.ts --variant fresh",
    "test:fresh": "ts-node -r reflect-metadata src/cli.ts --variant fresh",
    "test:takeover": "ts-node -r reflect-metadata src/cli.ts --variant takeover",
    "test:happy": "ts-node -r reflect-metadata src/cli.ts --variant fresh --mode happy",
    "test:happy:fresh": "ts-node -r reflect-metadata src/cli.ts --variant fresh --mode happy",
    "test:happy:takeover": "ts-node -r reflect-metadata src/cli.ts --variant takeover --mode happy",
    "test:auto:fresh": "AUTO_HEAL=true ts-node -r reflect-metadata src/cli.ts --variant fresh --mode happy",
    "test:auto:takeover": "AUTO_HEAL=true ts-node -r reflect-metadata src/cli.ts --variant takeover --mode happy",
    "test:state-management": "ts-node -r reflect-metadata src/cli.ts --variant state-management --mode scenarios",
    "test:state-management:all": "ts-node -r reflect-metadata src/cli.ts --variant state-management --mode all",
    "test:auto:state-management": "AUTO_HEAL=true ts-node -r reflect-metadata src/cli.ts --variant state-management --mode scenarios",
    "test:errors": "ts-node -r reflect-metadata src/cli.ts --variant fresh --mode errors",
    "test:errors:fresh": "ts-node -r reflect-metadata src/cli.ts --variant fresh --mode errors",
    "test:errors:takeover": "ts-node -r reflect-metadata src/cli.ts --variant takeover --mode errors",
    "report": "open reports/latest/report.html"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.24.0",
    "@modelcontextprotocol/server-filesystem": "latest",
    "@nestjs/common": "^10.4.22",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.22",
    "@nestjs/platform-express": "^10.4.22",
    "@playwright/mcp": "latest",
    "browser-tools-mcp": "latest",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^16.0.0",
    "playwright": "^1.44.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@types/express": "^5.0.6",
    "@types/node": "^20.0.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.0.0"
  }
}
